{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig to read more about this file */

    /* Language and Environment */
    "target": "es2024",                                  /* 設定 JavaScript 目標版本 */

    /* Modules (改為現代 Node ESM 規範) */
    "module": "nodenext",                                /* 產出符合 Node.js ESM 標準的模組代碼 */
    "moduleResolution": "nodenext",                      /* 讓 TS 採用與 Node.js 相同的 ESM 解析規則（必須明確加副檔名） */
    "rewriteRelativeImportExtensions": true,             /* 將輸出 JavaScript 的相對匯入改寫為 .js */

    /* JavaScript Support */
    "allowJs": true,                                     /* 允許 JS 檔案存在 */

    /* Emit */
    "outDir": "out",                                    /* 將編譯結果輸出至建置目錄 */

    /* Interop Constraints */
    "esModuleInterop": true,                             /* 支援 CommonJS 模組相容性 */
    "forceConsistentCasingInFileNames": true,            /* 確保檔名大小寫一致 */

    /* Type Checking */
    "strict": true,                                      /* 開啟全面嚴格型別檢查 */

    /* Completeness */
    "skipLibCheck": true                                 /* 跳過第三方宣告檔的檢查以加速編譯 */
  },
  "include": [
    "McHateBot.ts",
    "swagger.js",
    "commands/**/*.ts",
    "models/**/*.ts",
    "types/**/*.d.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["node_modules", "out", "dist", "exe"]
}